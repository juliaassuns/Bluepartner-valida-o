{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/(.*\\.(?:html|css|js|png|jpg|ico|svg))", "dest": "/public/$1" },
    { "src": "/validar(.*)", "dest": "/server.js" },
    { "src": "/superadmin", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
