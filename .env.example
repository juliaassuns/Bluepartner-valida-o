# Porta do servidor
PORT=3000

# Caminho do banco SQLite (padrão: ./data/bluepartner.db)
# DB_PATH=./data/bluepartner.db

# CORS origin (use * para dev, domínio específico em produção)
CORS_ORIGIN=*

# NODE_ENV
NODE_ENV=development

# ===== DATABASE =====
# ⚠️  PRODUÇÃO: Configure AZURE_SQL_CONNECTION_STRING para usar SQL Server
# Se não configurado, fallback automático para SQLite (desenvolvimento)
# AZURE_SQL_CONNECTION_STRING=Server=tcp:seu-servidor.database.windows.net,1433;Initial Catalog=bluepartner;User ID=admin;Password=SenhaForte123!@#;Encrypt=True;TrustServerCertificate=False;
# Ou com Managed Identity: Authentication=Active Directory Default;

# ===== SESSION =====
SESSION_SECRET=gere-um-segredo-aleatorio-aqui

# ===== ENTRA ID (Microsoft Login) =====
# App Registration no Azure AD para login de admin/superadmin
ENTRA_TENANT_ID=seu-tenant-id
ENTRA_CLIENT_ID=seu-client-id
ENTRA_CLIENT_SECRET=seu-client-secret
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback

# ===== GDAP (Microsoft Graph) =====
# App Registration no Entra ID do tenant parceiro (CSP)
# Permissão necessária: DelegatedAdminRelationship.ReadWrite.All (Application)
GDAP_TENANT_ID=seu-tenant-id
GDAP_CLIENT_ID=seu-client-id
GDAP_CLIENT_SECRET=seu-client-secret
GDAP_PARTNER_NAME=Blue Partner

# Link GDAP padrão (fallback se não tiver pool nem API)
# GDAP_DEFAULT_LINK=https://admin.microsoft.com/AdminPortal/Home#/partners/invitation/granularAdminRelationships/...

# Link GDAP padrão (fallback quando a API não está configurada)
# Cole aqui um link GDAP válido para ser usado em novos pedidos
# ATENÇÃO: Links GDAP são de uso único! Atualize após cada uso.
# GDAP_DEFAULT_LINK=https://admin.microsoft.com/AdminPortal/Home#/partners/invitation/granularAdminRelationships/SEU-ID-AQUI

# ===== INGRAM MICRO (API de licenças do distribuidor) =====
# Credenciais da API Ingram Micro Cloud
# Obtenha em: https://developer.ingrammicrocloud.com/
INGRAM_CLIENT_ID=seu-ingram-client-id
INGRAM_CLIENT_SECRET=seu-ingram-client-secret
# INGRAM_BASE_URL=https://api.ingrammicrocloud.com
# INGRAM_TOKEN_URL=https://api.ingrammicrocloud.com/oauth/token

# ===== TD SYNNEX / STREAMONE ION (API de licenças do distribuidor) =====
# Credenciais da API StreamOne Ion
# Obtenha em: https://developer.tdsynnex.com/
TDS_CLIENT_ID=seu-tds-client-id
TDS_CLIENT_SECRET=seu-tds-client-secret
# TDS_BASE_URL=https://api.streamonecloud.net
# TDS_TOKEN_URL=https://api.streamonecloud.net/oauth/token

# ===== FABRIC / POWER BI / ONELAKE (leitura de dados de revendas) =====
# Endpoint SQL do Fabric Lakehouse/Warehouse
FABRIC_SQL_SERVER=seu-workspace.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=nome-do-lakehouse-ou-warehouse

# Workspace do OneLake / Fabric (para descobrir lakehouses, tabelas, etc.)
FABRIC_WORKSPACE_ID=id-do-workspace-fabric

# Workspace e Dataset do Power BI (para queries DAX)
POWERBI_WORKSPACE_ID=id-do-workspace
POWERBI_DATASET_ID=id-do-dataset

# Credenciais Fabric (deixe vazio para reaproveitar ENTRA_*)
# FABRIC_TENANT_ID=
# FABRIC_CLIENT_ID=
# FABRIC_CLIENT_SECRET=
