# Porta do servidor
PORT=3000

# Caminho do banco SQLite (padrão: ./data/bluepartner.db)
# DB_PATH=./data/bluepartner.db

# CORS origin (use * para dev, domínio específico em produção)
CORS_ORIGIN=*

# NODE_ENV
NODE_ENV=development

# ===== GDAP (Microsoft Graph) =====
# App Registration no Entra ID do tenant parceiro (CSP)
# Permissão necessária: DelegatedAdminRelationship.ReadWrite.All (Application)
GDAP_TENANT_ID=seu-tenant-id
GDAP_CLIENT_ID=seu-client-id
GDAP_CLIENT_SECRET=seu-client-secret
GDAP_PARTNER_NAME=Blue Partner

# Link GDAP padrão (fallback quando a API não está configurada)
# Cole aqui um link GDAP válido para ser usado em novos pedidos
# ATENÇÃO: Links GDAP são de uso único! Atualize após cada uso.
# GDAP_DEFAULT_LINK=https://admin.microsoft.com/AdminPortal/Home#/partners/invitation/granularAdminRelationships/SEU-ID-AQUI
